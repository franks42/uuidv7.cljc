{:paths ["src" "test"]
 :deps  {}

 :tasks
 {test:bb
  {:doc  "Run library tests under bb"
   :task (do (require 'clojure.test 'uuidv7.core-test)
             (let [r (clojure.test/run-tests 'uuidv7.core-test)]
               (when (pos? (+ (:fail r) (:error r)))
                 (System/exit 1))))}

  test:jvm
  {:doc  "Run library tests on the JVM"
   ;; `clojure`, not `clj`: the rlwrap wrapper is not on CI runners
   :task (shell "clojure" "-M:test-clj" "-e"
                (str "(require '[clojure.test :as t] 'uuidv7.core-test)"
                     "(let [r (t/run-tests 'uuidv7.core-test)]"
                     "  (System/exit (if (pos? (+ (:fail r) (:error r))) 1 0)))"))}

  test:nbb
  {:doc  "Run library tests on nbb (Node.js)"
   :task (shell "nbb" "-cp" "src:test" "test/runners/test_nbb/core.cljs")}

  test:cljs
  {:doc  "Compile the library tests with ClojureScript and run them on Node.js"
   :task (do (shell "clojure" "-M:test-cljs")
             (shell "node" "target/cljs-test-out/test-cljs.js"))}

  test:scittle
  {:doc  "Run library tests in Scittle (headless Chromium via Playwright)"
   ;; Prerequisite (one-time): npm install && npx playwright install chromium
   :task (shell "node" "test/runners/run-scittle.mjs")}

  test:scittle-cdn
  {:doc  "Smoke-test the library from jsdelivr in Scittle (optional git ref, default main; network)"
   :task (apply shell "node" "test/runners/run-scittle-cdn.mjs" *command-line-args*)}

  test:nbb-git
  {:doc  "Smoke-test the README's nbb.edn git coordinates, with an empty gitlibs cache (network)"
   :requires ([babashka.fs :as fs])
   :task (let [readme (slurp "README.md")
               deps   (second (re-find (re-pattern "(?s)### nbb \\(nbb\\.edn\\).*?```clojure\n(.*?)```")
                                       readme))
               tag    (second (re-find (re-pattern ":git/tag \"v([^\"]+)\"") (str deps)))
               tmp    (str (fs/create-temp-dir {:prefix "uuidv7-nbb-git-"}))
               root   (System/getProperty "user.dir")]
           (when-not (and deps tag)
             (println "ERROR: no nbb.edn block with a :git/tag found in README.md")
             (System/exit 1))
           (spit (str tmp "/nbb.edn") deps)
           (print deps)
           (flush)
           (try
             (let [out (:out (shell {:dir tmp :out :string
                                     :extra-env {"GITLIBS" (str tmp "/gitlibs")}}
                                    "nbb" "-cp" (str root "/test/published")
                                    "-e" "(require 'published-smoke)"))]
               (print out)
               (when-not (clojure.string/includes? out (str "SMOKE OK " tag))
                 (println "ERROR: expected uuidv7" tag "from the README's git dep")
                 (System/exit 1)))
             (finally (fs/delete-tree tmp))))}

  test:published
  {:doc  "Test what the README tells users to load: its Scittle CDN ref and nbb git dep (network)"
   :task (let [ref (second (re-find (re-pattern "cdn\\.jsdelivr\\.net/gh/franks42/uuidv7\\.cljc@([^/]+)/")
                                    (slurp "README.md")))]
           (when-not ref
             (println "ERROR: no jsdelivr uuidv7 URL found in README.md")
             (System/exit 1))
           (shell "node" "test/runners/run-scittle-cdn.mjs" ref)
           (run 'test:nbb-git))}

  test:cli
  {:doc  "Run CLI integration tests (shells out to bin/uuidv7)"
   :task (do (require 'clojure.test 'uuidv7.cli-test)
             (let [r (clojure.test/run-tests 'uuidv7.cli-test)]
               (when (pos? (+ (:fail r) (:error r)))
                 (System/exit 1))))}

  install
  {:doc  "Install JAR to local Maven repo (~/.m2)"
   :task (shell "clojure" "-T:build" "install")}

  test:cli-release
  {:doc  "Install lib to local m2, then run bin/uuidv7 from a clean
          temp dir (no adjacent src/) so it goes through add-deps and
          resolves uuidv7 from Maven. Catches release-mode bugs."
   :task (do (run 'install)
             (let [tmp (str (System/getProperty "java.io.tmpdir")
                            "/uuidv7-cli-release-test")
                   root (System/getProperty "user.dir")]
               (.mkdirs (java.io.File. tmp))
               (shell "cp" (str root "/bin/uuidv7") tmp)
               (let [r   (shell {:dir tmp :out :string} "./uuidv7" "gen")
                     out (:out r)]
                 (if (and (string? out)
                          (re-matches (re-pattern "[0-9a-f-]{36}\\n") out))
                   (println "OK: release-mode CLI resolved uuidv7 from local m2 and produced a UUID:" (clojure.string/trim out))
                   (do (println "FAIL: release-mode CLI produced:" (pr-str out))
                       (System/exit 1))))))}

  release-check
  {:doc  "Refuse to release a non-stable version. Run before `git tag`."
   :task (let [src (slurp "bin/uuidv7")
               m   (re-find (re-pattern "\\(def version\\s+\"([^\"]+)\"") src)
               ver (second m)]
           (cond
             (nil? ver)
             (do (println "ERROR: couldn't parse version from bin/uuidv7")
                 (System/exit 1))

             (re-find (re-pattern "(?i)snapshot|alpha|beta|rc") ver)
             (do (println "ERROR: bin/uuidv7 version is" (str "\"" ver "\"")
                          "— refusing to release a non-stable version.")
                 (System/exit 1))

             (not (re-matches (re-pattern "\\d+\\.\\d+\\.\\d+") ver))
             (do (println "ERROR: version" (str "\"" ver "\"")
                          "is not a semver triple X.Y.Z")
                 (System/exit 1))

             :else
             (println "OK: version is" (str "\"" ver "\""))))}

  lint
  {:doc  "Run clj-kondo linter"
   :task (do (shell "clj-kondo" "--lint" "src" "test")
             ;; no .clj extension, so name the language explicitly
             (shell "clj-kondo" "--lang" "clj" "--lint" "bin/uuidv7"))}

  fmt
  {:doc  "Check cljfmt formatting"
   :task (shell "cljfmt" "check" "src" "test")}

  fmt:fix
  {:doc  "Fix cljfmt formatting"
   :task (shell "cljfmt" "fix" "src" "test")}

  check
  {:doc     "Run lint + fmt-check together (pre-commit gate)"
   :depends [lint fmt]}

  test:all
  {:doc  "Run library tests on every platform + CLI tests + lint + fmt"
   :task (do (run 'test:jvm)
             (run 'test:bb)
             (run 'test:nbb)
             (run 'test:cljs)
             (run 'test:scittle)
             (run 'test:cli)
             (run 'lint)
             (run 'fmt))}}}
